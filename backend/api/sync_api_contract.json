{
  "openapi": "3.1.0",
  "info": {
    "title": "GateAI Cloud Sync & Multi-Tenant Gateway API",
    "version": "1.0.0",
    "description": "Secure multi-tenant sync API for GateAI Android edge gate terminals and web portal."
  },
  "servers": [
    {
      "url": "https://api.gateai.enterprise.cloud/api/v1",
      "description": "Production Cloud Gateway"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "User JWT containing verified sub, company_id, site_id, and role claims."
      }
    },
    "schemas": {
      "SyncMutationItem": {
        "type": "object",
        "required": [
          "client_mutation_id",
          "entity_type",
          "entity_id",
          "operation",
          "payload",
          "client_timestamp"
        ],
        "properties": {
          "client_mutation_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique client mutation ID for idempotency."
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "VEHICLE",
              "VISITOR",
              "MATERIAL_MOVEMENT",
              "REPAIR",
              "DOCUMENT",
              "ALERT",
              "AUDIT_LOG"
            ]
          },
          "entity_id": {
            "type": "string",
            "description": "Business key or UUID of the entity."
          },
          "operation": {
            "type": "string",
            "enum": [
              "CREATE",
              "UPDATE",
              "RETURN",
              "CHECK_OUT",
              "DISMISS",
              "DELETE"
            ]
          },
          "payload": {
            "type": "object",
            "description": "Entity field map / JSON representation."
          },
          "client_timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PushSyncRequest": {
        "type": "object",
        "required": ["site_id", "mutations"],
        "properties": {
          "site_id": {
            "type": "string",
            "format": "uuid"
          },
          "mutations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SyncMutationItem"
            }
          }
        }
      },
      "MutationResult": {
        "type": "object",
        "required": ["client_mutation_id", "status"],
        "properties": {
          "client_mutation_id": {
            "type": "string",
            "format": "uuid"
          },
          "entity_type": {
            "type": "string"
          },
          "entity_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "DUPLICATE_IGNORED", "CONFLICT", "ERROR"]
          },
          "server_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          },
          "server_updated_at": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "error_message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "PushSyncResponse": {
        "type": "object",
        "required": ["server_time", "results"],
        "properties": {
          "server_time": {
            "type": "integer",
            "format": "int64"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MutationResult"
            }
          }
        }
      },
      "PullSyncResponse": {
        "type": "object",
        "required": ["server_time", "has_more", "changes"],
        "properties": {
          "server_time": {
            "type": "integer",
            "format": "int64"
          },
          "has_more": {
            "type": "boolean"
          },
          "changes": {
            "type": "object",
            "properties": {
              "vehicles": { "type": "array", "items": { "type": "object" } },
              "visitors": { "type": "array", "items": { "type": "object" } },
              "material_movements": { "type": "array", "items": { "type": "object" } },
              "material_movement_items": { "type": "array", "items": { "type": "object" } },
              "repair_records": { "type": "array", "items": { "type": "object" } },
              "documents": { "type": "array", "items": { "type": "object" } },
              "gate_alerts": { "type": "array", "items": { "type": "object" } }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/sync/push": {
      "post": {
        "summary": "Push batch mutations from terminal sync queue",
        "operationId": "pushSync",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushSyncRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch processed with individual mutation statuses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushSyncResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized / Invalid Token" },
          "403": { "description": "Forbidden / Site Mismatch" }
        }
      }
    },
    "/sync/pull": {
      "get": {
        "summary": "Pull incremental delta updates for terminal site",
        "operationId": "pullSync",
        "parameters": [
          {
            "name": "since_timestamp",
            "in": "query",
            "required": true,
            "schema": { "type": "integer", "format": "int64" },
            "description": "Last synced server timestamp in milliseconds"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 500 }
          }
        ],
        "responses": {
          "200": {
            "description": "Delta dataset since timestamp",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullSyncResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  }
}
